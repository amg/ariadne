# Development Environment Variables
# Copy to `.env.dev` for local development
# All variables are optional - defaults are provided for local development

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=3001
HOST=0.0.0.0
FRONTEND_PORT=5173

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_USER=postgres
DB_PASSWORD=devpassword
DB_NAME=chatbot_dev
DB_PORT=5432

# =============================================================================
# AI PROVIDER CONFIGURATION
# =============================================================================
# DeepInfra API key (optional for local dev - leave empty to skip AI)
DEEPINFRA_API_KEY=

# Model selection
DEFAULT_MODEL=Qwen/Qwen3.5-9B

# Mock inference server (development/testing only)
# MOCK_AI_BASE_URL=http://localhost:4141/v1

# Stream idle timeout (milliseconds)
AI_STREAM_IDLE_TIMEOUT_MS=5000

# Auto-titling time budget (milliseconds)
AI_TITLING_TIMEOUT_MS=5000

# Exchange staleness (milliseconds)
EXCHANGE_STALENESS_MS=300000

# Enable reasoning output
ENABLE_REASONING=true

# =============================================================================
# THREAD ANALYSIS (live drift gate)
# =============================================================================
THREAD_ANALYSIS_MODE=heuristic
JUDGE_MODEL=Qwen/Qwen3.5-9B
REWRITE_MODEL=Qwen/Qwen3.5-9B

# =============================================================================
# CORS (for local dev)
# =============================================================================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =============================================================================
# GLOBAL SPEND BUDGET (rate limiting)
# =============================================================================
# Daily spend budget in USD. Unset = no gate, fail open.
# DAILY_SPEND_BUDGET_USD=5.0
