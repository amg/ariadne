# Local Development Environment Template
# Copy to .env and customize for your machine
# Used with: npm run dev (automatic) or docker compose --env-file .env
# A commented-out line is optional and shows an example value; left unset,
# it takes the default named beside it.

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=3001
HOST=0.0.0.0
FRONTEND_PORT=5173

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Individual components (for docker-compose)
DB_USER=postgres
DB_PASSWORD=devpassword
DB_NAME=chatbot_dev
DB_PORT=15432
DB_HOST=localhost

# Connection string for local backend (connects to dockerized db on localhost)
DATABASE_URL=postgres://postgres:devpassword@localhost:15432/chatbot_dev

# =============================================================================
# SUPERTOKENS CONFIGURATION
# =============================================================================
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=dev-api-key

# =============================================================================
# AI PROVIDER CONFIGURATION
# =============================================================================
# Your DeepInfra key; used only while MOCK_AI_BASE_URL below is unset
DEEPINFRA_API_KEY=
DEFAULT_MODEL=Qwen/Qwen3.5-9B
TITLING_MODEL=Qwen/Qwen3.5-9B
REWRITE_MODEL=Qwen/Qwen3.5-9B
JUDGE_MODEL=Qwen/Qwen3.5-9B
MEMORY_MODEL=Qwen/Qwen3.5-9B
AI_STREAM_IDLE_TIMEOUT_MS=5000
AI_TITLING_TIMEOUT_MS=5000
EXCHANGE_STALENESS_MS=300000
GATE_WAIT_MS=10000
HANDOVER_WAIT_MS=10000
ENABLE_REASONING=true
# Logs what is sent to and received from the provider, outside production
DEBUG=false

# Mock inference server, for working without a DeepInfra key (development
# only). While set, it is used instead of DeepInfra; start it with
# `npm run mock --workspace=backend`.
# MOCK_AI_BASE_URL=http://localhost:4141/v1

# =============================================================================
# RATE LIMITING
# =============================================================================
# Daily spend budget in USD (optional, unset = no gate)
# DAILY_SPEND_BUDGET_USD=5.0

# =============================================================================
# THREAD ANALYSIS
# =============================================================================
THREAD_ANALYSIS_MODE=heuristic

# =============================================================================
# BACKGROUND WORKER
# =============================================================================
# Queue jobs one process runs side by side (default: 4)
# WORKER_JOB_CONCURRENCY=4

# =============================================================================
# SEVERAL BACKEND COPIES (aws-prod sets these; leave them unset at home)
# =============================================================================
# What this process runs: all, api or worker (default: all)
# PROCESS_ROLE=all
# The Valkey every copy shares for news between them (unset: one process)
# VALKEY_URL=redis://localhost:6379
# Milliseconds between an idle worker's looks for new jobs (unset: adding a
# job notifies the workers instead)
# QUEUE_POLL_MS=100
# Each app record also carries its figures as metrics (default: false)
# PUBLISH_METRICS=false

# =============================================================================
# MONITORING
# =============================================================================
# Seconds between the state records the backend logs (default: 20)
# STATE_LOG_INTERVAL_SECONDS=20

# =============================================================================
# FEATURE TOGGLES (read at boot; restart the backend after changing one)
# =============================================================================
# User memory: Fact capture, Thread Seeds, the Memory screen (default: false)
FEATURE_MEMORY=false

# =============================================================================
# CORS
# =============================================================================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# New account sign-up; sign-in is unaffected (default: true)
AUTH_SIGNUP_ENABLED=true
# A Cloudflare rule limits the sign-in routes, so the app leaves them
# unlimited (default: false, the app limits them itself)
# AUTH_RATE_LIMIT_AT_EDGE=false

# =============================================================================
# TESTS (npm test)
# =============================================================================
# The test database (unset: chatbot_test, created beside the database above)
# TEST_DATABASE_URL=postgres://postgres:devpassword@localhost:15432/chatbot_test
# The Valkey for the tests that cross backend copies (unset: one on port 6379
# beside the database or on this machine; without one, those tests are skipped)
# TEST_REDIS_URL=redis://localhost:6379

# =============================================================================
# HOME LOAD RUNS (npm run home:run --workspace=load)
# =============================================================================
# The password every load account signs in with
# LOAD_ACCOUNT_PASSWORD=change-me-load-password
# Where the run's guard reads this machine's load from Glances
# (default: http://localhost:61208/api/4)
# GLANCES_URL=http://localhost:61208/api/4
