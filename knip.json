{
  "$schema": "https://unpkg.com/knip/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["hadolint", "openssl"],
  "ignore": [".pi/agent/extensions/**"],
  "workspaces": {
    "lib": {
      "project": ["api/**/*.ts", "metrics/**/*.ts"]
    },
    "backend": {
      "entry": ["app/server.aws.ts"],
      "ignore": ["src/db/migrations/**"]
    },
    "load": {
      "entry": [
        "src/generator/main.ts",
        "src/rebuild/main.ts",
        "src/home/commands/run.ts",
        "src/home/commands/accounts.ts",
        "src/home/commands/clean.ts"
      ],
      "project": ["src/**/*.ts"]
    },
    "infra": {
      "entry": ["bin/*.ts", "lib/core/safetyNetHandler.ts"],
      "project": ["**/*.ts"],
      "ignoreDependencies": ["esbuild", "tsx"]
    }
  }
}
