{
  "name": "alex-chat-bot",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cross-env FORCE_COLOR=1 npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "enforce-cn": "node scripts/enforce-cn-rule.mjs",
    "test": "npm run test --workspaces --if-present",
    "analyze:thread": "npm run analyze:thread --workspace=backend --",
    "build:frontend": "npm run build --workspace=frontend",
    "migrate": "npm run migrate --workspace=backend",
    "migrate:prod": "npm run migrate:prod --workspace=backend",
    "audit:deps": "knip",
    "audit:boundaries": "depcruise frontend/src backend/src",
    "audit:env": "node scripts/checks/env-sync.mjs",
    "audit:docker": "node scripts/checks/docker-lint.mjs",
    "checks": "npm run typecheck && npm run lint && npm run enforce-cn && npm run audit:comments && npm run audit:deps && npm run audit:boundaries && npm run audit:env && npm run audit:docker",
    "audit:comments": "node scripts/checks/comment-hygiene.mjs",
    "gate": "npm run checks && npm run test && npm run build:frontend",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^18.3.1",
    "knip": "^6.35.1",
    "lefthook": "^2.1.14"
  },
  "dependencies": {
    "lucide-react": "^1.4.50"
  }
}
