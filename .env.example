# Chat Bot Environment Variables
# Copy to `.env` and fill in values
# All variables are optional - defaults are provided for local development

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Backend server port and host
PORT=3001
HOST=0.0.0.0

# Frontend development server port
FRONTEND_PORT=5173

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Option 1: Use connection string (recommended for production)
# DATABASE_URL=postgres://user:password@host:5432/chatbot

# Option 2: Use individual components (for docker-compose)
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=chatbot
DB_PORT=5432
DB_HOST=localhost

# =============================================================================
# AI PROVIDER CONFIGURATION
# =============================================================================
# DeepInfra API key (required for production AI)
DEEPINFRA_API_KEY=

# Model selection
DEFAULT_MODEL=Qwen/Qwen3.5-9B

# Model to use for auto-titling chats (defaults to DEFAULT_MODEL)
# TITLING_MODEL=Qwen/Qwen3.5-9B

# Mock inference server (development/testing only)
# Set to use local mock server instead of DeepInfra
# MOCK_AI_BASE_URL=http://localhost:4141/v1

# Stream idle timeout (milliseconds)
# AI will abort if no tokens received within this window
AI_STREAM_IDLE_TIMEOUT_MS=5000

# Auto-titling time budget (milliseconds)
# Titling gives up and falls back to "New Chat" after this window.
AI_TITLING_TIMEOUT_MS=5000

# =============================================================================
# THREAD ANALYSIS (live drift gate)
# =============================================================================
# Controls the live thread-analysis pipeline (ticket 002). Default: heuristic.
#   off        — surface gone: the pipeline is skipped, the Analysis tab is
#                hidden, and bubbles stay untinted. Stored signals survive.
#   heuristic  — live lane runs; only arrivals that look like follow-ups are
#                decontextualised before judging.
#   always     — live lane runs; every arrival is decontextualised first.
# THREAD_ANALYSIS_MODE=heuristic

# Judge / rewrite models used by the analysis pipeline (both default to
# Qwen/Qwen3.5-9B — small, cheap capacity is enough for classification and
# bounded rephrasing). Repoint independently when a better small model
# appears.
# JUDGE_MODEL=Qwen/Qwen3.5-9B
# REWRITE_MODEL=Qwen/Qwen3.5-9B

# =============================================================================
# AWS/CLOUD DEPLOYMENT
# =============================================================================
# For AWS deployment, use Network Load Balancer (NLB) for SSE support
# ALB has 60s idle timeout which may interrupt long-running streams
# API Gateway has 29s timeout - NOT suitable for SSE

# Configure keepalive/ping in your frontend to prevent idle timeout
# Consider WebSocket API for better AWS compatibility

# =============================================================================
# FRONTEND (Development Only)
# =============================================================================
# API proxy target for local development
# In production, frontend is served statically and calls backend directly
# VITE_API_PROXY_TARGET=http://localhost:3001
