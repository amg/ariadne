# Frontend Environment Variables
# Copy to `.env` and fill in values

# --- API Proxy (development only) ---
# Points to backend server. In production, frontend serves static files
# and API calls go directly to the backend through the load balancer.
# VITE_API_PROXY_TARGET=http://127.0.0.1:3001

# --- AWS/Cloud Deployment ---
# In production (AWS), the frontend is served via CloudFront/S3 or nginx,
# and API calls should use the actual backend URL (no proxy needed).
# The proxy is only for local development.
