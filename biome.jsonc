{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/infra/cdk.out",
      "!**/infra/node_modules",
      "!**/infra/.runs",
      "!**/rebuild/fixtures",
      "!**/*.generated.ts",
      // Biome 2 formats these languages by default; this repo keeps them as written.
      "!**/*.css",
      "!**/*.md",
      "!**/*.yml",
      "!**/*.yaml"
    ]
  },
  // Off: Biome 2 orders imports differently from Biome 1, so turning it on rewrites the import
  // block of most files. Turn it on in a change of its own.
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": "error"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 2
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 80,
            "skipBlankLines": true
          }
        }
      },
      "style": {
        "noNestedTernary": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      // tsconfig files are JSONC.
      "includes": ["**/tsconfig*.json"],
      "json": {
        "parser": {
          "allowComments": true,
          "allowTrailingCommas": true
        }
      }
    },
    {
      // Migrations are written against a schema that has no types yet, and a migration that
      // has run is never edited, so its length is not reshaped either.
      "includes": ["**/src/db/migrations/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          },
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          }
        }
      }
    },
    {
      // Tests, mocks, smoke tests and test fakes: table-driven helpers take several
      // inputs, and a describe block is long by design.
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/testing.ts",
        "backend/test/**",
        "backend/mock/**",
        "backend/smoke/**",
        "load/src/ecs/fakeEcs.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "useMaxParams": "off",
            "noExcessiveLinesPerFunction": "off"
          }
        }
      }
    },
    {
      // CDK fixes the (scope, id, props) shape of constructors and the helpers that follow it.
      "includes": ["infra/**"],
      "linter": {
        "rules": {
          "complexity": {
            "useMaxParams": "off"
          }
        }
      }
    },
    {
      // Generated by the shadcn CLI (components.json), so its shape is not ours to change.
      "includes": ["frontend/src/components/ui/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          }
        }
      }
    },
    {
      // Files that break useMaxParams or noExcessiveLinesPerFunction today and are not yet
      // reshaped. A path comes off this list once its file fits both rules.
      "includes": [
        "backend/app/routes/chat/post.ts",
        "backend/app/routes/settings/index.ts",
        "backend/queue/worker.ts",
        "backend/src/config/env.ts",
        "backend/src/services/aiService/pricing.ts",
        "backend/src/services/aiService/rewrite.ts",
        "backend/src/services/memory/captureSegments.ts",
        "backend/src/services/memory/readFacts.ts",
        "backend/src/services/messageService.ts",
        "backend/src/services/threadAnalysis/messageTransformer/verdictAndFoldStep.ts",
        "backend/src/services/threadAnalysis/verdict.ts",
        "backend/src/services/titlingService.ts",
        "frontend/src/components/chat/AnalysisTab/DriftChart.tsx",
        "frontend/src/components/chat/AnalysisTab/model.ts",
        "frontend/src/components/layout/ThreadSidebar.tsx",
        "frontend/src/services/api.ts",
        "lib/metrics/catalogue.ts",
        "lib/metrics/emf.ts",
        "load/src/archive/appRecords.ts",
        "load/src/archive/aws/awsCollection.ts",
        "load/src/archive/aws/discover.ts",
        "load/src/archive/aws/sdk/failures.ts",
        "load/src/archive/aws/sdk/insights.ts",
        "load/src/archive/aws/sdk/logs.ts",
        "load/src/archive/aws/sdk/metrics.ts",
        "load/src/archive/collect.ts",
        "load/src/archive/files.ts",
        "load/src/archive/sealRun.ts",
        "load/src/archive/selfChecks.ts",
        "load/src/archive/slices.ts",
        "load/src/criteria/criteria.ts",
        "load/src/ecs/carryOutRun.ts",
        "load/src/ecs/ecsLauncher.ts",
        "load/src/home/generatorRun.ts",
        "load/src/home/options.ts",
        "load/src/home/runFolder.ts",
        "load/src/home/stack/devStack.ts",
        "load/src/home/watch/houseWatch.ts",
        "load/src/monitor/cloudwatch.ts",
        "load/src/monitor/table.ts",
        "load/src/rebuild/judging/crossChecks.ts",
        "load/src/rebuild/report/builder.ts",
        "load/src/rebuild/report/lineChart.ts",
        "load/src/rebuild/report/sections/whatUsersAndAppSee.ts",
        "load/src/rebuild/runData/loadRun.ts",
        "load/src/rebuild/table/columns/awsColumns.ts",
        "load/src/records/versioned.ts",
        "load/src/run/supervise.ts",
        "load/src/scale/scaleRun.ts",
        "scripts/checks/comment-hygiene.mjs"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "useMaxParams": "off",
            "noExcessiveLinesPerFunction": "off"
          }
        }
      }
    }
  ]
}
