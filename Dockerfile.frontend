FROM node:22-alpine

WORKDIR /app

# Copy all package files (workspace setup)
COPY package*.json ./
COPY lib/package.json ./lib/
COPY frontend/package*.json ./frontend/

# Drop privileges for the build
RUN chown -R node:node /app
USER node

# Install dependencies (workspace-aware, skip scripts for CI/CD)
ENV LEFTHOOK=0
RUN npm ci --ignore-scripts

# Copy the shared contract and the frontend source
COPY --chown=node:node lib ./lib
COPY --chown=node:node frontend ./frontend

# Build the frontend
WORKDIR /app/frontend
RUN npm run build

# Use nginx for production serving
FROM nginx:alpine

# Copy custom nginx config
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets
COPY --from=0 /app/frontend/dist /usr/share/nginx/html

# Renames the tab when TITLE_PREFIX is set; nginx's entrypoint runs it at start
COPY --chmod=755 frontend/docker-entrypoint.d/40-title-prefix.sh /docker-entrypoint.d/

# Run as non-root: listen 8080 (see nginx.conf), writable pid/cache paths
RUN touch /run/nginx.pid \
    && chown -R nginx:nginx /var/cache/nginx /run/nginx.pid /usr/share/nginx/html
USER nginx

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
