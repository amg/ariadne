FROM node:22-alpine

WORKDIR /app

# Copy all package files (workspace setup)
COPY package*.json ./
COPY lib/package.json ./lib/
COPY backend/package*.json ./backend/

# Install dependencies (workspace-aware, skip scripts for CI/CD)
ENV LEFTHOOK=0
RUN npm ci --ignore-scripts

# Copy backend source
COPY lib ./lib
COPY backend ./backend

# Typecheck must pass for the image to build (defense in depth: the
# pre-commit gate runs it too, but builds can bypass hooks)
WORKDIR /app/backend
RUN npm run typecheck

# Bundle the server and worker into dist/. Packages stay in node_modules.
# tsx stays in the image too: migrations and the mock server still use it.
RUN npm run build

# Expose the default backend port (runtime port comes from the PORT env var)
EXPOSE 3001

# Drop privileges
USER node

# Stack traces point at the .ts sources through the bundle's source maps.
ENV NODE_ENV=production \
    NODE_OPTIONS=--enable-source-maps

# node itself is the container's main process, so stop signals reach the
# server's own handler. If boot fails the process exits, so the container's
# restart policy can bring it back.
CMD ["node", "dist/server.js"]
