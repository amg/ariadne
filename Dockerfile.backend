FROM node:20-alpine

WORKDIR /app

# Copy all package files (workspace setup)
COPY package*.json ./
COPY backend/package*.json ./backend/

# Install dependencies (workspace-aware)
RUN npm ci

# Copy backend source
COPY backend ./backend

# Typecheck
WORKDIR /app/backend
RUN npm run typecheck || true

# Expose port (configurable via ENV)
EXPOSE ${PORT:-3001}

# Drop privileges
USER node

# Start the server
CMD ["npm", "run", "dev"]
