FROM node:20-alpine

WORKDIR /app

# Copy all package files (workspace setup)
COPY package*.json ./
COPY backend/package*.json ./backend/

# Install dependencies (workspace-aware)
RUN npm ci

# Copy backend source
COPY backend ./backend

# Typecheck must pass for the image to build (defense in depth: the
# pre-commit gate runs it too, but builds can bypass hooks)
WORKDIR /app/backend
RUN npm run typecheck

# Expose the default backend port (runtime port comes from the PORT env var)
EXPOSE 3001

# Drop privileges
USER node

# Start the server
CMD ["npm", "run", "dev"]
