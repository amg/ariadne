FROM node:20-alpine

WORKDIR /app

# Copy root package files (workspace setup)
COPY package*.json ./
COPY backend/package*.json ./backend/

# Install dependencies (workspace-aware, include dev for tsx)
RUN npm ci

# Copy backend source code
COPY backend/ ./backend/

# Typecheck (optional, helps catch issues early)
WORKDIR /app/backend
RUN npm run typecheck || true

# Expose port (configurable via ENV)
EXPOSE ${PORT:-3001}

# Drop privileges
USER node

# Start the server
CMD ["npm", "run", "dev"]
