FROM node:22-alpine

WORKDIR /app

# Copy all package files (workspace setup)
COPY package*.json ./
COPY backend/package*.json ./backend/

# Install dependencies (workspace-aware, skip scripts for CI/CD)
ENV LEFTHOOK=0
RUN npm ci --ignore-scripts

# Copy backend source
COPY backend ./backend

# Typecheck must pass for the image to build (defense in depth: the
# pre-commit gate runs it too, but builds can bypass hooks)
WORKDIR /app/backend
RUN npm run typecheck

# Expose the default backend port (runtime port comes from the PORT env var)
EXPOSE 3001

# Drop privileges
USER node

ENV NODE_ENV=production

# Start the server without the file watcher: if boot fails the process exits,
# so the container's restart policy can bring it back.
CMD ["npm", "start"]
