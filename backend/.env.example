# Copy to `.env` and fill in values. Loaded by app/server.ts via dotenv.

# --- Server Configuration (AWS/cloud-compatible) ---
# PORT=3001
# HOST=0.0.0.0

# --- Database (single connection string, or DB_* parts; URL wins if both) ---
# DATABASE_URL=postgres://user:password@host:5432/chatbot
# Second standing pool for bench review; leave unset to disable the bench switch.
# BENCH_DATABASE_URL=postgres://user:password@host:5432/chatbot_bench
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=chatbot
# DB_USER=postgres
# DB_PASSWORD=

# --- AI provider (see features/ai-connector/MVP.md) ---
# Real provider: API key for DeepInfra.
DEEPINFRA_API_KEY=
# Optional model/endpoint overrides.
DEFAULT_MODEL=Qwen/Qwen3.5-9B
# Point the provider at the bundled mock inference server instead of DeepInfra
# (no key needed then): start it with `npm run mock` in backend/.
MOCK_AI_BASE_URL=http://localhost:4141/v1
# Inter-token idle deadline in ms (0 disables the guard). Default: 5000.
AI_STREAM_IDLE_TIMEOUT_MS=5000
# Enable reasoning/thinking output (default: true). Set to 'false' to disable.
ENABLE_REASONING=true
# Allowed CORS origins, comma-separated (default: localhost/127.0.0.1:5173).
# Only meaningful for cross-origin deployments; the vite dev proxy and a
# same-origin nginx proxy bypass CORS entirely.
CORS_ORIGINS=
# Verbose dev logging (ignored in production): drops the log level to debug
# and prints provider request/response payloads (e.g. the titling prompt and
# the returned title) as colored ▼ request / ▲ response blocks.
DEBUG=false
# Live thread-analysis pipeline (default: heuristic). off = pipeline skipped
# and the Analysis surface hidden; heuristic = expand arrivals that read like
# follow-ups; always = expand every arrival.
# THREAD_ANALYSIS_MODE=heuristic

# Judge / rewrite models for the analysis pipeline; both default to
# Qwen/Qwen3.5-9B (classification and bounded rephrasing — small capacity
# is enough).
# JUDGE_MODEL=Qwen/Qwen3.5-9B
# REWRITE_MODEL=Qwen/Qwen3.5-9B

