{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "tsx watch app/server.ts",
    "start": "tsx app/server.ts",
    "worker": "tsx app/worker.ts",
    "mock": "tsx mock/server.ts",
    "build": "esbuild app/server.ts app/server.aws.ts app/worker.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outdir=dist",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "tsx scripts/migrate-prod.ts",
    "queue:retry-failed": "tsx scripts/queue-retry-failed.ts",
    "smoke": "tsx smoke/e2e.ts",
    "try:analyze": "tsx scripts/try-analyze-thread.ts",
    "analyze:thread": "tsx scripts/analyze-thread.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "validate:env": "tsx scripts/validate-env-usage.ts",
    "gate": "npm run typecheck && npm run lint && npm run validate:env && npm run test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@ai-sdk/deepinfra": "^3.0.48",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "ai": "^7.0.99",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.4",
    "graphile-worker": "^0.18.0",
    "ioredis": "^5.11.1",
    "js-tiktoken": "^1.0.21",
    "kysely": "^0.29.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "supertokens-node": "^24.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
