# Production Environment Variables
# Copy to `.env.prod` for production deployment
# All variables marked REQUIRED must be set

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=3001
HOST=0.0.0.0

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Production database credentials - CHANGE THESE!
DB_USER=chatbot_prod
DB_PASSWORD=REQUIRED_CHANGE_THIS_SECURE_PASSWORD
DB_NAME=chatbot_prod
DB_PORT=15432

# =============================================================================
# AI PROVIDER CONFIGURATION
# =============================================================================
# DeepInfra API key (REQUIRED for production)
DEEPINFRA_API_KEY=REQUIRED_YOUR_DEEPINFRA_API_KEY

# Model selection
DEFAULT_MODEL=Qwen/Qwen3.5-9B

# Stream idle timeout (milliseconds)
AI_STREAM_IDLE_TIMEOUT_MS=5000

# Auto-titling time budget (milliseconds)
AI_TITLING_TIMEOUT_MS=5000

# Exchange staleness (milliseconds)
EXCHANGE_STALENESS_MS=300000

# How long a chat request waits for the drift gate verdict (milliseconds)
GATE_WAIT_MS=10000

# How long a handover waits for the old chat's memory before answering "still saving" (milliseconds)
HANDOVER_WAIT_MS=10000

# Enable reasoning output
ENABLE_REASONING=true

# =============================================================================
# THREAD ANALYSIS (live drift gate)
# =============================================================================
THREAD_ANALYSIS_MODE=heuristic
JUDGE_MODEL=Qwen/Qwen3.5-9B
REWRITE_MODEL=Qwen/Qwen3.5-9B
MEMORY_MODEL=Qwen/Qwen3.5-9B

# =============================================================================
# FEATURE TOGGLES (read at boot; restart the backend after changing one)
# =============================================================================
# User memory: Fact capture, Thread Seeds, the Memory screen (default: false)
FEATURE_MEMORY=false

# =============================================================================
# CORS (adjust for your domain)
# =============================================================================
CORS_ORIGINS=https://chat.yourdomain.com

# =============================================================================
# GLOBAL SPEND BUDGET (rate limiting)
# =============================================================================
# Daily spend budget in USD. REQUIRED for production.
# This is the last defense against fund loss.
DAILY_SPEND_BUDGET_USD=5.0

# New account sign-up; sign-in is unaffected (default: true)
AUTH_SIGNUP_ENABLED=true
